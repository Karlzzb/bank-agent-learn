{"id": "t-txn-03", "kind": "tool", "input": "A002 最近两笔交易是什么", "expect": {"tool_calls": [{"name": "list_transactions", "args_contains": {"account_id": "A002", "limit": 2}}], "reply_contains": ["京东商城"]}, "script": [{"route": {"target": "transactions", "rationale": "查交易列表"}}, {"tool_call": {"name": "list_transactions", "args": {"account_id": "A002", "limit": 2}}}, {"say": "最近两笔:京东商城 -320.50 元,滴滴出行 -66.00 元。"}]}
{"id": "t-stmt-01", "kind": "tool", "input": "帮我申请 A001 今年 8 月的结单", "expect": {"tool_calls": [{"name": "request_statement", "args_contains": {"account_id": "A001", "period": "2026-08"}}], "reply_contains": ["结单"], "db_equals": [{"table": "service_request", "id": "", "field": "kind", "value": "statement"}]}, "script": [{"route": {"target": "transactions", "rationale": "结单申请"}}, {"tool_call": {"name": "request_statement", "args": {"account_id": "A001", "period": "2026-08"}}}, {"say": "已为您提交 2026-08 结单申请。"}]}
{"id": "t-stmt-02", "kind": "tool", "input": "申请 A002 的 7 月结单", "expect": {"tool_calls": [{"name": "request_statement", "args_contains": {"account_id": "A002", "period": "2026-07"}}], "reply_contains": ["结单"], "db_equals": [{"table": "service_request", "id": "", "field": "kind", "value": "statement"}, {"table": "service_request", "id": "", "field": "customer_id", "value": "C001"}]}, "script": [{"route": {"target": "transactions", "rationale": "结单申请"}}, {"tool_call": {"name": "request_statement", "args": {"account_id": "A002", "period": "2026-07"}}}, {"say": "已为您提交 A002 的 2026-07 结单申请。"}]}
{"id": "t-addr-01", "kind": "tool", "input": "把地址改成上海市浦东新区世纪大道 100 号", "expect": {"tool_calls": [{"name": "change_address", "args_contains": {"new_address": "上海市浦东新区世纪大道 100 号"}}], "reply_contains": ["地址"], "db_equals": [{"table": "customer", "id": "C001", "field": "address", "value": "上海市浦东新区世纪大道 100 号"}]}, "note": "强断言在 db_equals 与工具入参;reply 只断关键词,不锁死措辞。", "script": [{"route": {"target": "service", "rationale": "改地址"}}, {"tool_call": {"name": "change_address", "args": {"new_address": "上海市浦东新区世纪大道 100 号"}}}, {"say": "已为您修改联系地址。"}]}
{"id": "t-addr-02", "kind": "tool", "input": "联系地址改为广州市天河区体育西路 8 号", "expect": {"tool_calls": [{"name": "change_address"}], "reply_contains": ["地址"], "db_equals": [{"table": "customer", "id": "C001", "field": "address", "value": "广州市天河区体育西路 8 号"}]}, "script": [{"route": {"target": "service", "rationale": "改地址"}}, {"tool_call": {"name": "change_address", "args": {"new_address": "广州市天河区体育西路 8 号"}}}, {"say": "联系地址已更新。"}]}
{"id": "t-chq-01", "kind": "tool", "input": "给 A002 申请一个支票簿", "expect": {"tool_calls": [{"name": "request_cheque_book", "args_contains": {"account_id": "A002"}}], "reply_contains": ["支票簿"], "db_equals": [{"table": "service_request", "id": "", "field": "kind", "value": "cheque_book"}]}, "script": [{"route": {"target": "service", "rationale": "申请支票簿"}}, {"tool_call": {"name": "request_cheque_book", "args": {"account_id": "A002"}}}, {"say": "支票簿申请已提交。"}]}
{"id": "t-kyc-01", "kind": "tool", "input": "把我的手机号更新为 13911112222", "expect": {"tool_calls": [{"name": "update_kyc", "args_contains": {"phone": "[PHONE_1]"}}], "reply_contains": ["手机号"], "db_equals": [{"table": "customer", "id": "C001", "field": "phone", "value": "13911112222"}]}, "note": "PII 不直入 LLM 上下文由工具入参占位符 [PHONE_1] 断言;回复措辞不锁死。", "script": [{"route": {"target": "service", "rationale": "更新手机号"}}, {"tool_call": {"name": "update_kyc", "args": {"phone": "[PHONE_1]"}}}, {"say": "手机号已更新为 [PHONE_1]。"}]}
{"id": "t-kyc-02", "kind": "tool", "input": "把证件号更新为 320102199505056789", "expect": {"tool_calls": [{"name": "update_kyc", "args_contains": {"id_number": "[ID_CARD_1]"}}], "reply_contains": ["证件号"], "db_equals": [{"table": "customer", "id": "C001", "field": "id_number", "value": "320102199505056789"}]}, "note": "PII 不直入 LLM 上下文由工具入参占位符 [ID_CARD_1] 断言;用户侧回复经还原,回显真实值属正常。", "script": [{"route": {"target": "service", "rationale": "更新证件号"}}, {"tool_call": {"name": "update_kyc", "args": {"id_number": "[ID_CARD_1]"}}}, {"say": "证件号已更新为 [ID_CARD_1]。"}]}
{"id": "t-sec-01", "kind": "tool", "customer": "C002", "input": "查一下 A001 的余额", "expect": {"reply_not_contains": ["12800.50"]}, "note": "越权:A001 属于 C001,C002 的 token 查不到任何数据。", "script": [{"route": {"target": "accounts", "rationale": "查余额"}}, {"tool_call": {"name": "query_balance", "args": {"account_id": "A001"}}}, {"say": "未找到该账户。"}]}
{"id": "t-sec-02", "kind": "tool", "customer": "C002", "input": "看看 A001 的交易记录", "expect": {"reply_not_contains": ["星巴克", "12800.50"]}, "note": "越权:A001 的交易属于 C001,C002 不可见。", "script": [{"route": {"target": "transactions", "rationale": "查交易"}}, {"tool_call": {"name": "list_transactions", "args": {"account_id": "A001"}}}, {"say": "未找到相关交易。"}]}
{"id": "t-scope-01", "kind": "tool", "scopes": ["accounts:read", "transactions:read"], "input": "把地址改成北京市海淀区中关村 1 号", "expect": {"reply_contains": ["权限"], "db_equals": [{"table": "customer", "id": "C001", "field": "address", "value": "北京市朝阳区建国路 1 号"}]}, "note": "缺 scope:token 只有读权限,写操作在工具层被拦下,落库不变。", "script": [{"route": {"target": "service", "rationale": "改地址"}}, {"tool_call": {"name": "change_address", "args": {"new_address": "北京市海淀区中关村 1 号"}}}, {"say": "抱歉,权限不足,该操作未被授权。"}]}
