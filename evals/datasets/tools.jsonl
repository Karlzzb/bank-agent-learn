{"id": "t-bal-01", "kind": "tool", "input": "帮我查一下余额", "expect": {"tool_calls": [{"name": "query_balance"}], "reply_contains": ["12800.50", "3200.00"]}, "script": [{"route": {"target": "accounts", "rationale": "查余额"}}, {"tool_call": {"name": "query_balance", "args": {}}}, {"say": "您的储蓄账户余额为 12800.50 元,活期账户余额为 3200.00 元。"}]}
{"id": "t-bal-02", "kind": "tool", "input": "查一下 A002 的余额", "expect": {"tool_calls": [{"name": "query_balance", "args_contains": {"account_id": "A002"}}], "reply_contains": ["3200.00"]}, "script": [{"route": {"target": "accounts", "rationale": "指定账户查余额"}}, {"tool_call": {"name": "query_balance", "args": {"account_id": "A002"}}}, {"say": "A002 活期账户余额为 3200.00 元。"}]}
{"id": "t-bal-03", "kind": "tool", "input": "A001 还剩多少钱", "expect": {"tool_calls": [{"name": "query_balance", "args_contains": {"account_id": "A001"}}], "reply_contains": ["12800.50"]}, "script": [{"route": {"target": "accounts", "rationale": "指定账户查余额"}}, {"tool_call": {"name": "query_balance", "args": {"account_id": "A001"}}}, {"say": "A001 储蓄账户余额为 12800.50 元。"}]}
{"id": "t-txn-01", "kind": "tool", "input": "看看 A001 最近的交易", "expect": {"tool_calls": [{"name": "list_transactions", "args_contains": {"account_id": "A001"}}], "reply_contains": ["星巴克"]}, "script": [{"route": {"target": "transactions", "rationale": "查交易列表"}}, {"tool_call": {"name": "list_transactions", "args": {"account_id": "A001", "limit": 3}}}, {"say": "最近交易:星巴克 -58.00 元,工资入账 15000.00 元。"}]}
