# LLM provider(OpenAI 兼容接口,如 DeepSeek)
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_API_KEY=

# mock 银行核心数据库文件
BANK_DB_PATH=bank.sqlite3

# mock IdP:JWT 本地固定密钥与有效期(仅开发/教学用,生产应换真 IdP)
JWT_SECRET=dev-only-fixed-secret-change-me-in-real-deploy
JWT_TTL_SECONDS=3600

# MCP Server(Streamable HTTP)
MCP_ACCOUNTS_URL=http://127.0.0.1:8101/mcp
MCP_TRANSACTIONS_URL=http://127.0.0.1:8102/mcp
MCP_SERVICE_URL=http://127.0.0.1:8103/mcp
MCP_ACCOUNTS_PORT=8101
MCP_TRANSACTIONS_PORT=8102
MCP_SERVICE_PORT=8103

# FastAPI
API_PORT=8000

# Langfuse:仅平台化阶段(E7)需要,本阶段留空即可(变量名为 langfuse SDK 标准约定)
# LANGFUSE_BASE_URL=http://localhost:3000
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
