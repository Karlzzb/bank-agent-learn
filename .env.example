# LLM provider(OpenAI 兼容接口,如 DeepSeek)
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_API_KEY=

# mock 银行核心数据库文件
BANK_DB_PATH=bank.sqlite3

# mock IdP:JWT 本地固定密钥与有效期(仅开发/教学用,生产应换真 IdP)
JWT_SECRET=dev-only-fixed-secret-change-me-in-real-deploy
JWT_TTL_SECONDS=3600

# MCP Server(Streamable HTTP)
MCP_ACCOUNTS_URL=http://127.0.0.1:8101/mcp
MCP_TRANSACTIONS_URL=http://127.0.0.1:8102/mcp
MCP_SERVICE_URL=http://127.0.0.1:8103/mcp
MCP_ACCOUNTS_PORT=8101
MCP_TRANSACTIONS_PORT=8102
MCP_SERVICE_PORT=8103

# FastAPI
API_PORT=8000

# Edge:限流(单客户每分钟 /chat 请求数)
RATE_LIMIT_PER_MINUTE=60

# launcher 是否同时用 docker compose 拉起 Langfuse(无 docker 时自动跳过)
LAUNCH_LANGFUSE=true

# Langfuse 可观测性(变量名为 langfuse SDK 标准约定):
# 下面是 docker-compose.yml 里 LANGFUSE_INIT_* 自动建好的本地开发 key,照抄即可用;
# 留空则关闭 trace,系统照常运行。自建其他 Langfuse 实例时换成对应项目的 key。
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-bank-agent-dev
LANGFUSE_SECRET_KEY=sk-lf-bank-agent-dev

# 会话持久化与长期记忆(SQLite)
CHECKPOINT_DB_PATH=checkpoints.sqlite3
MEMORY_STORE_PATH=memory.sqlite3

# 会话内记忆:消息数超阈值后,最旧一段压缩为摘要,保留最近若干条原文
HISTORY_MAX_MESSAGES=12
HISTORY_KEEP_RECENT=4
